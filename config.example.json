{
  "engine": "onnx",
  "onnx_model": "models/onnx/gigaam_int8.onnx",
  "tokenizer": "models/onnx/tokenizer.model",
  "gigaam_revision": "e2e_ctc",
  "gigaam_cache": "models/gigaam",
  "model": "models/large-v3-turbo",
  "language": "ru",
  "hotkey": "tilde",
  "mode": "hold",
  "compute_type": "int8",
  "cpu_threads": 8,
  "beam_size": 1,
  "vad_filter": true,
  "initial_prompt": "Это диктовка на русском языке. Расставляй знаки препинания и заглавные буквы.",
  "input_device": null,
  "insert_method": "type",
  "trailing_space": true,
  "restore_clipboard": true,
  "beep": true,
  "tray": true,
  "vad": true,
  "min_speech_seconds": 0.3,
  "min_seconds": 0.35,
  "max_seconds": 60
}
